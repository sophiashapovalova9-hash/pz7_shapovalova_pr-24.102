<Page x:Class="pr3_shapovalova.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr3_shapovalova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Auto" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="pswbPassword"/>
            <TextBox x:Name="txtPasswordVisible" Visibility="Collapsed"/>
            <CheckBox x:Name="chkShowPassword" Content="Показать пароль"
                      Checked="chkShowPassword_Checked"
                      Unchecked="chkShowPassword_Unchecked"/>

            <TextBlock x:Name="txtBlockCaptcha" Text="Капча:" Visibility="Hidden"/>
            <Grid Visibility="Hidden" x:Name="gridCaptcha">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtboxCaptcha" Grid.Column="0"/>
                <TextBlock x:Name="tblCaptcha" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
            </Grid>

            <Button x:Name="btnRefreshCaptcha" Margin="5,5,5,5" Content="Обновить CAPTCHA" Click="btnRefreshCaptcha_Click" Visibility="Collapsed"/>

            <TextBlock x:Name="txtAttemptsInfo" Foreground="DarkOrange" FontWeight="Bold" Visibility="Collapsed"/>
            <TextBlock x:Name="txtLockoutInfo" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Height="80" HorizontalAlignment="Center">
                <Button x:Name="btnEnterGuests" Margin="5,15,5,5" Content="Войти как гость" Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" Margin="5,15,5,5" Content="Войти" Click="btnEnter_Click"/>
                <Button x:Name="btnRegister" Margin="5,15,5,5" Content="Регистрация" Click="btnRegisterPage_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>